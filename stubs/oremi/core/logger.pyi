import logging
from _typeshed import Incomplete
from typing import Any

class OremiFormatter(logging.Formatter):
    error_fmt: str
    error_formatter: Incomplete
    def __init__(self, fmt: str = ..., datefmt: str = ..., style: str = ..., validate: bool = ...) -> None: ...
    def formatException(self, ei: Any) -> str: ...

class Logger(logging.Logger):
    global_level: Incomplete
    log_filename: Incomplete
    def __init__(self, name: str, *, level: int | None = ..., filename: str | None = ...) -> None: ...
    @classmethod
    def set_global_level(cls, level: int) -> None: ...
    @classmethod
    def create(cls, name: str, *, level: int | None = ..., filename: str | None = ...) -> Logger: ...
    def clone(self, name: str) -> Logger: ...
